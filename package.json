{
  "name": "aicostcalc",
  "version": "0.1.0",
  "private": true,
  "description": "Free tool to calculate and compare API pricing across 10+ LLMs (OpenAI, Anthropic, Google, DeepSeek, xAI, Mistral) including caching and Batch API discounts.",
  "license": "MIT",
  "homepage": "https://aicostcalc.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leolionel221/aicostcalc.git"
  },
  "bugs": {
    "url": "https://github.com/Leolionel221/aicostcalc/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "pricing",
    "calculator",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "cost-comparison",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "data:sync": "node scripts/sync-prices.mjs",
    "data:sync:write": "node scripts/sync-prices.mjs --write",
    "data:format": "node scripts/format-data.mjs",
    "check:workflows": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
